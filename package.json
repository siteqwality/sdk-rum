{
  "name": "@siteqwality/rum",
  "version": "2.0.0",
  "description": "SiteQwality Real User Monitoring SDK",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/esm",
    "dist/cjs",
    "dist/types"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationDir dist/types",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bundle": "vitest run --config vitest.bundle.config.ts",
    "test:browser": "playwright test",
    "size": "node scripts/size.mjs",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run build:types && npm run test && npm run test:bundle && node scripts/check-package.cjs",
    "size:modules": "node scripts/size.mjs --modules"
  },
  "keywords": [
    "rum",
    "real-user-monitoring",
    "monitoring",
    "web-vitals",
    "session-replay",
    "error-tracking",
    "performance",
    "siteqwality"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siteqwality/sdk-rum.git"
  },
  "homepage": "https://siteqwality.com",
  "bugs": {
    "url": "https://github.com/siteqwality/sdk-rum/issues"
  },
  "author": "SiteQwality",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rrweb/types": "2.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "acorn": "^8.18.0",
    "jsdom": "^27.0.1",
    "rollup": "^4.59.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@rrweb/record": "2.1.4",
    "tslib": "^2.8.1"
  },
  "overrides": {
    "rrweb": "2.1.4",
    "rrdom": "2.1.4",
    "rrweb-snapshot": "2.1.4",
    "@rrweb/types": "2.1.4",
    "@rrweb/utils": "2.1.4"
  }
}
